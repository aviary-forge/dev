# email-loader configuration
#
# Copy this file to config.yaml and fill in your IMAP + OAuth2 credentials.
#
# OAuth2 setup (Outlook / Exchange Online):
#   1. Register an application in Azure AD (Entra ID):
#      https://portal.azure.com -> App registrations -> New registration
#   2. Under "Certificates & secrets", create a client secret
#   3. Under "API permissions", add Mail.Read (application permission)
#   4. Grant admin consent for the permission
#   5. Fill in the oauth2 section below

imap:
  host: outlook.office365.com
  port: 993
  username: ""                           # Your email address
  oauth2:
    client_id: ""                        # Application (client) ID from Azure AD
    client_secret: ""                    # Client secret
    tenant_id: ""                        # Directory (tenant) ID

# Where to store emails and the SQLite index
storage:
  dir: ~/.local/share/email-classifier

# Folders to skip during sync
skip_folders:
  - Deleted Items
  - Junk Email
  - Drafts
  - Junk
  - Trash
  - "[Gmail]/Trash"
  - "[Gmail]/Spam"
